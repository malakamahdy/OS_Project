FROM alpine:3.19

RUN mkdir -p /app/certs

RUN echo "AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE" > /app/.env && \
    echo "AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY" >> /app/.env && \
    echo "GITHUB_TOKEN=ghp_aBcDeFgHiJkLmNoPqRsTuVwXyZ123456" >> /app/.env && \
    echo "STRIPE_SECRET_KEY=sk_live_abcdefghijklmnopqrstuvwx" >> /app/.env && \
    echo "DATABASE_PASSWORD=superSecretPassword123!" >> /app/.env && \
    echo "JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.secret" >> /app/.env

RUN printf '%s\n' '-----BEGIN RSA PRIVATE KEY-----' \
    'MIIEowIBAAKCAQEA2a2rwplBQLzHPZe5RJr9FAKE' \
    'EXAMPLEKEYCONTENTDONOTUSE1234567890ABCD' \
    '-----END RSA PRIVATE KEY-----' > /app/certs/private.key

RUN printf '[database]\nhost=prod-db.internal\nuser=admin\npassword=Pr0d_P@ssw0rd_2024\n' > /app/config.ini

CMD ["sh", "-c", "echo 'Secrets demo container running' && sleep infinity"]